{
  "name": "jbh-private-order-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "typecheck:worker": "tsc -p admin/payment-worker/tsconfig.json",
    "test:worker": "tsc -p admin/payment-worker/tsconfig.behavior.json && node --test admin/tests/private-order-worker-*.test.mjs",
    "dry-run:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "verify:worker": "npm run typecheck:worker && npm run test:worker && npm run dry-run:worker",
    "typecheck:contact": "tsc -p contact-worker/tsconfig.json --noEmit",
    "test:contact": "node --test contact-worker/tests/contact-ingress-contract.test.mjs",
    "dry-run:contact": "wrangler deploy --dry-run --config contact-worker/wrangler.jsonc --outdir .wrangler/contact-dry-run",
    "verify:contact-ingress": "npm run typecheck:contact && npm run test:contact && npm run dry-run:contact",
    "deploy": "wrangler deploy",
    "deploy:contact": "wrangler deploy --config contact-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.4",
    "stripe": "17.7.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "typescript": "5.6.3",
    "wrangler": "4.118.0"
  }
}
