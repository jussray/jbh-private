{
  "name": "jbh-private-order-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "typecheck:worker": "tsc -p admin/payment-worker/tsconfig.json",
    "test:worker": "tsc -p admin/payment-worker/tsconfig.behavior.json && node --test admin/tests/private-order-worker-*.test.mjs",
    "dry-run:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "verify:commerce-seam": "node scripts/verify-commerce-seam.mjs",
    "verify:worker:cloudflare": "node scripts/verify-cloudflare-worker-identity.mjs && npm run verify:commerce-seam && tsc --noEmit --module ESNext --target ES2022 --strict --lib ES2022,DOM,DOM.Iterable --esModuleInterop --skipLibCheck --moduleResolution bundler --types node admin/payment-worker/src/shopify-physical-order-model.ts",
    "verify:worker": "npm run verify:commerce-seam && npm run typecheck:worker && npm run test:worker && npm run dry-run:worker",
    "verify:control-room-local": "node scripts/control-room-local-runner.mjs",
    "test:control-room": "node --test test/control-room-test-ledger.test.mjs test/control-room-local-runner.test.mjs",
    "build:x-engagement": "node -e \"require('node:fs').rmSync('.cache/x-engagement-build',{recursive:true,force:true})\" && tsc -p automation/social/tsconfig.json",
    "verify:x-engagement": "npm run build:x-engagement && node --test automation/social/x-engagement-adapter.test.mjs",
    "query:x-engagement": "npm run build:x-engagement && node .cache/x-engagement-build/x-engagement-cli.js",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.4",
    "apify-client": "2.24.0",
    "stripe": "17.7.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "typescript": "5.6.3",
    "wrangler": "4.118.0"
  }
}
